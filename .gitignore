*.mp4
*.webm
*.mkv
*.avi
!data/sample/
!data/sample/**

# Trained experiment heads (MLP / GRU / Omni)
checkpoints/
*.ckpt

# Downloaded foundation weights (calibration.json stays tracked)
models/**/*.pt
models/**/*.bin
models/**/*.safetensors
models/**/*.gguf
models/**/*.onnx
models/**/*.pth

# Hugging Face / torch hubs if ever cached inside the repo
.cache/

# Regenerable eval outputs (re-run: python src/main.py)
results/*
!results/.gitkeep

# Archived experiment run logs / JSONL (write-up is in docs/experiments.md)
experiments/*
!experiments/README.md
